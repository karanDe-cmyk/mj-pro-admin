@Library('Shared') _
pipeline {
    agent any
    
    parameters {
        string(name: 'BACKEND_DOCKER_TAG', defaultValue: '', description: 'Backend Docker tag of the image built by the CI job')
    }

    stages {
        stage("Workspace Cleanup") {
            steps {
                cleanWs()
            }
        }

        stage('Git: Code Checkout') {
            steps {
                git credentialsId: 'Github-Cred', url: 'https://github.com/MaccoTechgit/Matka-Fronted.git', branch: 'himanshu'
            }
        }

        stage('Verify: Docker Image Tags') {
            steps {
                echo "BACKEND_DOCKER_TAG: ${params.BACKEND_DOCKER_TAG}"
            }
        }

        stage("Update: Kubernetes Manifests") {
            steps {
                script {
                    dir('kubernetes') {
                        sh """
                        sed -i -E 's|(image: saurav547/matka-backend:)[^ ]+|\\1${params.BACKEND_DOCKER_TAG}|' backend.yaml
                        """
                    }
                }
            }
        }

        stage("Git: Code Update and Push") {
            steps {
                script {
                    withCredentials([gitUsernamePassword(credentialsId: 'Github-Cred', gitToolName: 'Default')]) {
                        sh '''
                        git config --global user.email "sauravgarg5922.com"
                        git config --global user.name "sauravgarg547"
                        git add .
                        git commit -m "Updated backend image tag to ${params.BACKEND_DOCKER_TAG}"
                        git push origin himanshu
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                emailext attachLog: true,
                from: 'sauravgarg5922@gmail.com',
                subject: "Matka Backend Updated & Deployed - ${currentBuild.result}",
                body: """
                    <html>
                    <body>
                        <div style="background-color: #FFA07A; padding: 10px;">
                            <p><strong>Project:</strong> ${env.JOB_NAME}</p>
                        </div>
                        <div style="background-color: #90EE90; padding: 10px;">
                            <p><strong>Build Number:</strong> ${env.BUILD_NUMBER}</p>
                        </div>
                        <div style="background-color: #87CEEB; padding: 10px;">
                            <p><strong>Build URL:</strong> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                        </div>
                    </body>
                    </html>
                """,
                to: 'sauravgarg5922@gmail.com',
                mimeType: 'text/html'
            }
        }

        failure {
            script {
                emailext attachLog: true,
                from: 'sauravgarg5922@gmail.com',
                subject: "Matka Backend Deployment Failed - ${currentBuild.result}",
                body: """
                    <html>
                    <body>
                        <div style="background-color: #FFA07A; padding: 10px;">
                            <p><strong>Project:</strong> ${env.JOB_NAME}</p>
                        </div>
                        <div style="background-color: #90EE90; padding: 10px;">
                            <p><strong>Build Number:</strong> ${env.BUILD_NUMBER}</p>
                        </div>
                        <div style="background-color: #FF6347; padding: 10px;">
                            <p><strong>Error:</strong> Check logs in Jenkins</p>
                        </div>
                    </body>
                    </html>
                """,
                to: 'sauravgarg5922@gmail.com',
                mimeType: 'text/html'
            }
        }
    }
}
