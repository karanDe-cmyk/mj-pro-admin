@Library('Shared') _
pipeline {
    agent any
    
    parameters {
        string(name: 'FRONTEND_DOCKER_TAG', defaultValue: '', description: 'frontend Docker tag of the image built by the CI job')
    }

    environment {
        ARGOCD_SERVER = '15.207.103.107:31102'  // Your ArgoCD URL
        ARGOCD_TOKEN = credentials('argocd-api-token') // Store token in Jenkins credentials
        APP_NAME = 'JANNAT-ADMIN-APP'  // ArgoCD application name
    }

    stages {
        stage("Validate Parameters") {
            steps {
                script {
                    if (params.FRONTEND_DOCKER_TAG == '') {
                        error("FRONTEND_DOCKER_TAG must be provided.")
                    }
                }
            }
        }

        stage("Workspace Cleanup") {
            steps {
                script {
                    cleanWs()
                }
            }
        }
        
        stage('Git: Code Checkout') {
            steps {
                script {
                    git credentialsId: 'Github-Cred', url: 'https://github.com/MaccoTechgit/Matka-Fronted.git', branch: 'jannat-frontend-admin'
                }
            }
        }
        
        stage("Verify: Docker Image Tags") {
            steps {
                script {
                    echo "Using FRONTEND_DOCKER_TAG: ${params.FRONTEND_DOCKER_TAG}"
                }
            }
        }
        
        stage("Update: Kubernetes Manifests") {
            steps {
                script {
                    dir('kubernetes') {
                        sh """
                            #!/bin/bash
                            sed -i 's|image: saurav547/jannat-frontend-admin-prod:.*|image: saurav547/jannat-frontend-admin-prod:${params.FRONTEND_DOCKER_TAG}|' frontend.yaml
                        """
                    }
                }
            }
        }

        stage("Git: Commit & Push Updates") {
            steps {
                script {
                    withCredentials([gitUsernamePassword(credentialsId: 'Github-Cred', gitToolName: 'Default')]) {
                        sh '''
                            #!/bin/bash
                            git config --global user.email "sauravgarg5922@gmail.com"
                            git config --global user.name "sauravgarg547"

                            echo "Checking repository status..."
                            git status
                            
                            echo "Adding changes..."
                            git add kubernetes/frontend.yaml
                            
                            echo "Committing changes..."
                            git commit -m "Updated frontend image tag to ${FRONTEND_DOCKER_TAG}" || echo "No changes to commit"
                            
                            echo "Pushing changes..."
                            git push origin jannat-frontend-admin
                        '''
                    }
                }
            }
        }

        // ✅ Automate ArgoCD Sync & Prune after Git Update
        stage("Sync ArgoCD") {
            steps {
                script {
                    sh '''
                        curl -k -X POST https://${ARGOCD_SERVER}/api/v1/applications/${APP_NAME}/sync \
                        -H "Authorization: Bearer ${ARGOCD_TOKEN}" \
                        -H "Content-Type: application/json" \
                        -d '{ "prune": true, "dryRun": false, "strategy": { "hook": { } } }'
                    '''
                }
            }
        }
    }
    
    post {
        success {
            script {
                emailext attachLog: true,
                from: 'jenkins@yourcompany.com',
                subject: "SUCCESS: ${env.JOB_NAME} Deployment Completed - Build ${env.BUILD_NUMBER}",
                body: """
                    <html>
                        <body style="font-family: Arial, sans-serif; background-color: #f4f7fa; padding: 30px; margin: 0;">
                            <table style="width: 100%; max-width: 600px; background-color: #ffffff; border-radius: 8px; border: 1px solid #e1e1e1; margin: 0 auto;">
                                <tr>
                                    <td style="padding: 20px; text-align: center; background-color: #28a745; color: #ffffff; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                                        <img src="https://yourcompany.com/logo.png" alt="Company Logo" width="150" style="max-width: 100%;" />
                                        <h2 style="font-size: 24px; margin-top: 15px;">${env.JOB_NAME} - Build ${env.BUILD_NUMBER}</h2>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px; color: #555555; font-size: 16px;">
                                        <p style="font-weight: bold; color: #28a745; font-size: 18px;">Deployment Successful</p>
                                        <p style="margin: 15px 0;">
                                            <strong>Build Status:</strong> <span style="color: #28a745;">SUCCESS</span><br>
                                            <strong>Triggered By:</strong> ${env.BUILD_USER_ID ? env.BUILD_USER_ID : 'Unknown'}<br>
                                            <strong>Environment:</strong> ${env.BRANCH_NAME ? env.BRANCH_NAME : 'Not Available'}<br>
                                            <strong>Build URL:</strong> <a href="${env.BUILD_URL}" style="color: #007bff;">Click here to view the build</a>
                                        </p>
                                        <hr style="border: 1px solid #e1e1e1;">
                                        <p style="font-size: 16px; line-height: 1.6;">
                                            Your deployment was successful. You can view more details in the Jenkins build or click the link above to see the results.
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="background-color: #f8f9fa; padding: 20px; text-align: center; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                                        <p style="font-size: 14px; color: #555555;">
                                            This email was automatically generated by Jenkins. If you have any questions, please contact <a href="mailto:support@yourcompany.com" style="color: #007bff;">support@yourcompany.com</a>.
                                        </p>
                                        <p style="font-size: 14px; color: #007bff;">&copy; ${new java.util.Date().year + 1900} YourCompany. All Rights Reserved.</p>
                                    </td>
                                </tr>
                            </table>
                        </body>
                    </html>
                """,
                to: 'team@yourcompany.com, devops@yourcompany.com',
                mimeType: 'text/html'
            }
        }

        failure {
            script {
                emailext attachLog: true,
                from: 'jenkins@yourcompany.com',
                subject: "URGENT: ${env.JOB_NAME} Deployment Failed - Build ${env.BUILD_NUMBER}",
                body: """
                    <html>
                        <body style="font-family: Arial, sans-serif; background-color: #f4f7fa; padding: 30px; margin: 0;">
                            <table style="width: 100%; max-width: 600px; background-color: #ffffff; border-radius: 8px; border: 1px solid #e1e1e1; margin: 0 auto;">
                                <tr>
                                    <td style="padding: 20px; text-align: center; background-color: #007bff; color: #ffffff; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                                        <img src="https://yourcompany.com/logo.png" alt="Company Logo" width="150" style="max-width: 100%;" />
                                        <h2 style="font-size: 24px; margin-top: 15px;">${env.JOB_NAME} - Build ${env.BUILD_NUMBER}</h2>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px; color: #555555; font-size: 16px;">
                                        <p style="font-weight: bold; color: #d9534f; font-size: 18px;">Deployment Failed</p>
                                        <p style="margin: 15px 0;">
                                            <strong>Build Status:</strong> <span style="color: #d9534f;">FAILED</span><br>
                                            <strong>Triggered By:</strong> ${env.BUILD_USER_ID ? env.BUILD_USER_ID : 'Unknown'}<br>
                                            <strong>Environment:</strong> ${env.BRANCH_NAME ? env.BRANCH_NAME : 'Not Available'}<br>
                                            <strong>Build URL:</strong> <a href="${env.BUILD_URL}" style="color: #007bff;">Click here to view the build</a>
                                        </p>
                                        <hr style="border: 1px solid #e1e1e1;">
                                        <p style="font-size: 16px; line-height: 1.6;">
                                            Please review the build logs to troubleshoot the failure. You can find more details below or <a href="${env.BUILD_URL}" style="color: #007bff;">click here to view the build logs</a>.
                                        </p>
                                        <p style="font-size: 16px; font-weight: bold; color: #d9534f;">
                                            Error logs are attached for your review.
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="background-color: #f8f9fa; padding: 20px; text-align: center; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                                        <p style="font-size: 14px; color: #555555;">
                                            This email was automatically generated by Jenkins. If you have any questions, please contact <a href="mailto:support@yourcompany.com" style="color: #007bff;">support@yourcompany.com</a>.
                                        </p>
                                        <p style="font-size: 14px; color: #007bff;">&copy; ${new java.util.Date().year + 1900} YourCompany. All Rights Reserved.</p>
                                    </td>
                                </tr>
                            </table>
                        </body>
                    </html>
                """,
                to: 'team@yourcompany.com, devops@yourcompany.com',
                mimeType: 'text/html'
            }
        }
    }
}
